---
import Layout from '../../../layouts/Layout.astro';
---

<Layout lang="zh" lic={'数据来源：<a href="https://pubchem.ncbi.nlm.nih.gov/" target="_blank" rel="noopener">PubChem</a>（NCBI）· 2D 绘制与描述符：<a href="https://www.rdkit.org/" target="_blank" rel="noopener">RDKit</a> · <a href="https://www.ebi.ac.uk/chembl/" target="_blank" rel="noopener">ChEMBL</a> · <a href="https://www.nlm.nih.gov/research/umls/rxnorm/" target="_blank" rel="noopener">RxNorm</a>（NLM）· <a href="https://cactus.nci.nih.gov/chemical/structure" target="_blank" rel="noopener">NCI CIR</a> · <a href="https://coconut.naturalproducts.net/" target="_blank" rel="noopener">COCONUT</a> (CC BY 4.0) · GHS pictograms: <a href="https://unece.org/transport/dangerous-goods/ghs-rev10" target="_blank" rel="noopener">UN GHS Rev.10</a>'} active="mol" title="分子工具 · TubeCalc"
  note="原理：分子量＝Σ(相对原子质量×原子数)，支持括号与水合物，相对原子质量取 IUPAC 标准值。文献：Meija J, Coplen TB, Berglund M, et al. Atomic weights of the elements 2013. Pure Appl Chem. 2016;88(3):265-91."
>

<main class="container">
  <h1 class="page-title">分子工具</h1>
  <p class="page-desc">输入化学式（支持嵌套括号与水合物）、SMILES 串或化合物名——输入类型自动识别；SMILES 与名称还会绘制 2D 结构式。</p>

  <div class="panel in-grid">
    <div class="in-left">
    <label for="q">化学式 · SMILES · 化合物名 —— 自动识别</label>
    <input type="text" id="q" placeholder="例：C6H12O6、CuSO4·5H2O、CC(=O)Oc1ccccc1C(=O)O 或 caffeine（咖啡因）" autocomplete="off" autocapitalize="none" autocorrect="off" spellcheck="false">
    <div class="hint">一个输入框全兼容：化学式（支持嵌套括号与水合物）、SMILES 结构式、或经 PubChem 解析的化合物名——输入类型自动识别。</div>
    <button class="btn" id="calcBtn">计算</button>
    <span class="hint" style="display:inline-block;margin-left:10px">试一试：
      <a href="#" class="eg" data-f="C6H12O6">C6H12O6</a> · <a href="#" class="eg" data-f="CuSO4·5H2O">CuSO4·5H2O</a> · <a href="#" class="eg" data-f="(NH4)2SO4">(NH4)2SO4</a> · <a href="#" class="eg" data-f="Ca(OH)2">Ca(OH)2</a> · <a href="#" class="eg-s" data-s="CC(=O)Oc1ccccc1C(=O)O">阿司匹林</a> · <a href="#" class="eg-s" data-s="CN1C=NC2=C1C(=O)N(C(=O)N2C)C">咖啡因</a> · <a href="#" class="eg-s" data-s="OC[C@H]1O[C@H](O)[C@H](O)[C@H](O)[C@H]1O">葡萄糖</a> · <a href="#" class="eg-s" data-s="NC(CO)(CO)CO">Tris</a> · <a href="#" class="eg-s" data-s="OC(=O)CN(CCN(CC(=O)O)CC(=O)O)CC(=O)O">EDTA</a>
    </span>
    </div>
    <button type="button" class="draw-card" id="drawBtn">
      <span class="dc-ico">🧪</span>
      <span class="dc-tx">画 / 载入分子</span>
      <span class="dc-sub">手绘结构或粘贴 MOL，自动识别并检索</span>
    </button>
    <div class="error" id="err"></div>

</div>

  <div class="panel result" id="resultPanel" style="display:none">
    <div class="res-head"><div class="hint" id="modeBadge" style="display:none"></div><div class="dl-wrap" id="dlWrap" style="display:none"><button class="btn" id="dlBtn">下载 &#9662;</button><div class="dl-menu" id="dlMenu"><button class="dl-item" data-fmt="svg">SVG</button><button class="dl-item" data-fmt="png">PNG</button><button class="dl-item" data-fmt="jpeg">JPEG</button><button class="dl-item" data-fmt="webp">WebP</button></div></div></div>

    <div class="eng-sw" id="engSw"><span class="eng-lb">绘制引擎</span><div class="eng-dd" id="engDd"><button type="button" class="eng-cur" id="engCur">RDKit <span class="eng-car">&#9662;</span></button><div class="eng-menu" id="engMenu" style="display:none"><button type="button" class="eng-item" data-e="rdkit">RDKit</button><button type="button" class="eng-item" data-e="sd">SmilesDrawer</button><button type="button" class="eng-item" data-e="cdk">CDK</button><button type="button" class="eng-item" data-e="indigo">Indigo</button><button type="button" class="eng-item" data-e="chematic">Chematic</button></div></div></div>
<div class="struct-wrap" id="structWrap" style="display:none"><div id="structSvg"></div></div>
    
    <div id="mwBlock"><label style="margin-top:12px">摩尔质量</label>
    <div class="big-number"><span id="mwVal"></span><small>g/mol</small></div>
    <div class="hint" id="fLine" style="margin-top:8px"></div>
    <div id="compTable"></div></div>
    <div id="resStatics" style="display:none"></div>
    <div id="molInfo" class="mol-info" style="display:none"></div>
  </div>
    <div class="hint" id="sVia" style="display:none;margin-top:8px"></div><div id="kModal" style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(29,29,31,.5)"><div style="position:absolute;inset:3vh 3vw;background:#fff;border-radius:16px;display:flex;flex-direction:column;overflow:hidden;box-shadow:0 24px 64px rgba(0,0,0,.25)"><div style="display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 16px;border-bottom:1px solid #e5e5ea;flex-wrap:wrap"><b style="font-size:15px">Ketcher</b><div style="display:flex;gap:8px"><button type="button" class="btn" id="kApply">应用</button><button type="button" class="btn" id="kClose" style="background:#8e8e93">关闭</button></div></div><div id="kApp" style="flex:1;min-height:0;position:relative"></div></div></div>
  </div>

  <div class="panel result" id="convPanel" style="display:none">
    <label>质量 ⇌ 摩尔换算（使用上方摩尔质量）</label>
    <div class="row">
      <div>
        <label for="massIn">质量 m (g)</label>
        <input type="number" inputmode="decimal" id="massIn" step="any" placeholder="留空则按摩尔计算质量">
      </div>
      <div>
        <label for="molIn">物质的量 n (mol)</label>
        <input type="number" inputmode="decimal" id="molIn" step="any" placeholder="留空则按质量计算摩尔">
      </div>
    </div>
    <div class="big-number" id="convOut" style="font-size:20px"></div>
  </div>


  <style is:inline>
.struct-wrap{border:1px solid var(--border);border-radius:12px;background:#fff;padding:12px;margin-top:14px;display:flex;justify-content:center}
.struct-wrap svg{max-width:100%;height:auto}
    .in-grid{display:grid;grid-template-columns:1fr;gap:14px}
  @media(min-width:900px){.in-grid{grid-template-columns:1fr 236px;align-items:stretch}}
  .draw-card{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:7px;border:1.5px dashed #b9d6f2;border-radius:14px;background:linear-gradient(160deg,#f4f9ff,#eaf3ff);color:#0a66c2;cursor:pointer;font-size:15.5px;font-weight:600;padding:18px 14px;min-height:118px;font-family:inherit;transition:border-color .15s,background .15s}
  .draw-card:hover{border-color:#0a84ff;background:linear-gradient(160deg,#ecf5ff,#dfeeff)}
  .draw-card .dc-ico{font-size:26px;line-height:1}
  .draw-card .dc-sub{font-size:12px;font-weight:400;color:#5a7fa6;line-height:1.55;text-align:center}
  .draw-card .dc-sub a{color:#0a84ff;text-decoration:underline;pointer-events:none}
</style>
</main>


<script is:inline>
'use strict';
const MASS = {H:1.008,He:4.0026,Li:6.94,Be:9.0122,B:10.81,C:12.011,N:14.007,O:15.999,F:18.998,
Ne:20.180,Na:22.990,Mg:24.305,Al:26.982,Si:28.085,P:30.974,S:32.06,Cl:35.45,Ar:39.948,
K:39.098,Ca:40.078,Sc:44.956,Ti:47.867,V:50.942,Cr:51.996,Mn:54.938,Fe:55.845,Co:58.933,
Ni:58.693,Cu:63.546,Zn:65.38,Ga:69.723,Ge:72.630,As:74.922,Se:78.971,Br:79.904,Kr:83.798,
Rb:85.468,Sr:87.62,Y:88.906,Zr:91.224,Nb:92.906,Mo:95.95,Tc:98,Ru:101.07,Rh:102.91,
Pd:106.42,Ag:107.87,Cd:112.41,In:114.82,Sn:118.71,Sb:121.76,Te:127.60,I:126.90,Xe:131.29,
Cs:132.91,Ba:137.33,La:138.91,Ce:140.12,Pr:140.91,Nd:144.24,Pm:145,Sm:150.36,Eu:151.96,
Gd:157.25,Tb:158.93,Dy:162.50,Ho:164.93,Er:167.26,Tm:168.93,Yb:173.05,Lu:174.97,Hf:178.49,
Ta:180.95,W:183.84,Re:186.21,Os:190.23,Ir:192.22,Pt:195.08,Au:196.97,Hg:200.59,Tl:204.38,
Pb:207.2,Bi:208.98,Po:209,At:210,Rn:222,Fr:223,Ra:226,Ac:227,Th:232.04,Pa:231.04,U:238.03,
Np:237,Pu:244};

// 解析一个片段（不含水合物分隔符），返回元素计数对象
function parseSegment(seg) {
  let i = 0, mult = 1;
  const m = seg.match(/^\s*(\d+)/);
  if (m) { mult = parseInt(m[1], 10); i = m[1].length; }
  const counts = {};
  const stack = [counts];
  let stackTop = 0;
  while (i < seg.length) {
    const ch = seg[i];
    if (ch === '(') { stack.push({}); stackTop++; i++; }
    else if (ch === ')') {
      if (stackTop === 0) throw '括号不匹配';
      i++;
      let j = i; while (j < seg.length && /\d/.test(seg[j])) j++;
      const n = (j > i) ? parseInt(seg.slice(i, j), 10) : 1;
      const group = stack.pop(); stackTop--;
      const top = stack[stackTop];
      for (const el in group) top[el] = (top[el] || 0) + group[el] * n;
      i = j;
    }
    else if (/[A-Z]/.test(ch)) {
      let sym = ch;
      if (i + 1 < seg.length && /[a-z]/.test(seg[i + 1])) { sym += seg[i + 1]; }
      if (!(sym in MASS)) throw '无法识别的元素符号：' + sym;
      i += sym.length;
      let j = i; while (j < seg.length && /\d/.test(seg[j])) j++;
      const n = (j > i) ? parseInt(seg.slice(i, j), 10) : 1;
      const top = stack[stackTop];
      top[sym] = (top[sym] || 0) + n;
      i = j;
    }
    else if (/[a-z]/.test(ch)) { throw '元素符号位置出现小写字母（' + ch + '），请检查大小写'; }
    else { throw '无法识别的字符：' + ch; }
  }
  if (stackTop !== 0) throw '括号不匹配';
  if (mult > 1) for (const el in counts) counts[el] *= mult;
  if (Object.keys(counts).length === 0) throw '存在空的片段';
  return counts;
}

function parseFormula(input) {
  const segs = input.split(/[·.\*]/);
  const total = {};
  for (const seg of segs) {
    if (!seg.trim()) throw '存在空的片段（检查分隔符）';
    const c = parseSegment(seg);
    for (const el in c) total[el] = (total[el] || 0) + c[el];
  }
  return total;
}

function fmt(x) {
  return Math.abs(x - Math.round(x)) < 1e-9 ? String(Math.round(x)) : String(Math.round(x * 10000) / 10000);
}

// 质量 ⇌ 摩尔换算
function convertMassMol() {
  const mw = parseFloat(document.getElementById('mwVal').textContent);
  if (!mw) return;
  const mIn = document.getElementById('massIn'), nIn = document.getElementById('molIn');
  const m = parseFloat(mIn.value), n = parseFloat(nIn.value);
  const out = document.getElementById('convOut');
  const editingMass = document.activeElement === mIn;
  const editingMol = document.activeElement === nIn;
  if (editingMass && isFinite(m) && m > 0) {
    nIn.value = (Math.round(m / mw * 1e6) / 1e6);
    out.textContent = nIn.value + ' mol ⇌ ' + m + ' g';
  } else if (editingMol && isFinite(n) && n > 0) {
    mIn.value = (Math.round(n * mw * 1e6) / 1e6);
    out.textContent = mIn.value + ' g ⇌ ' + n + ' mol';
  }
}
document.getElementById('massIn').addEventListener('input', convertMassMol);
document.getElementById('molIn').addEventListener('input', convertMassMol);
</script>

<script is:inline src="/js/smiles-drawer.min.js?v=2" defer></script>
<script is:inline>
(function () {
  'use strict';
  const L = { hzHdr: '主要危害', hzSig: '信号词', hzPict: '象形图', hzP: "防范说明", common: '通用名', brand: '商品名', kApply: '应用', kClose: '关闭', noZh: '暂未收录该中文名，请改用英文名、CAS 号或 SMILES', npName: '名称', npVia: '来自 COCONUT', iupac: 'IUPAC 名称', hbd: '氢键供体', hba: '氢键受体', rot: '可旋转键', chg: '形式电荷', heavy: '重原子数', viaF: '结构式：PubChem 按该分子式匹配的最接近结果', pubHdr: 'PubChem 数据', rdkHdr: 'RDKit 本地计算', viaSmi: '已在 PubChem 匹配该化合物', prefName: '首选名称', maxPhase: '最高研发阶段', molType: '类型', therapeutic: '治疗用', bioact: '生物活性', cheblErr: 'ChEMBL 查询失败：请检查 ID（如 CHEMBL25）', viaCir: 'CAS 号已经 NCI CIR 解析', casErr: 'CAS 号解析失败：请改用化合物名或核对 CAS 号', exM: '精确质量', rings: '环数', arom: '芳香环', empty: '请输入化学式、SMILES 串或化合物名称', invalid: 'SMILES 无效：', pub: '无法经 PubChem 解析该名称（无网络或未收录）。请检查名称，或直接粘贴 SMILES 串。', via: '结构与分子式经 PubChem 解析', hill: '分子式（Hill）：', modeF: '已识别为化学式', modeS: '2D结构式' };
  const TH = ['元素', '原子数', '相对原子质量', '贡献 (g/mol)'];
  const $ = (id) => document.getElementById(id);
  const TC_MASS = {H:1.008,He:4.0026,Li:6.94,Be:9.0122,B:10.81,C:12.011,N:14.007,O:15.999,F:18.998,
Ne:20.180,Na:22.990,Mg:24.305,Al:26.982,Si:28.085,P:30.974,S:32.06,Cl:35.45,Ar:39.948,
K:39.098,Ca:40.078,Sc:44.956,Ti:47.867,V:50.942,Cr:51.996,Mn:54.938,Fe:55.845,Co:58.933,
Ni:58.693,Cu:63.546,Zn:65.38,Ga:69.723,Ge:72.630,As:74.922,Se:78.971,Br:79.904,Kr:83.798,
Rb:85.468,Sr:87.62,Y:88.906,Zr:91.224,Nb:92.906,Mo:95.95,Tc:98,Ru:101.07,Rh:102.91,
Pd:106.42,Ag:107.87,Cd:112.41,In:114.82,Sn:118.71,Sb:121.76,Te:127.60,I:126.90,Xe:131.29,
Cs:132.91,Ba:137.33,La:138.91,Ce:140.12,Pr:140.91,Nd:144.24,Pm:145,Sm:150.36,Eu:151.96,
Gd:157.25,Tb:158.93,Dy:162.50,Ho:164.93,Er:167.26,Tm:168.93,Yb:173.05,Lu:174.97,Hf:178.49,
Ta:180.95,W:183.84,Re:186.21,Os:190.23,Ir:192.22,Pt:195.08,Au:196.97,Hg:200.59,Tl:204.38,
Pb:207.2,Bi:208.98,Po:209,At:210,Rn:222,Fr:223,Ra:226,Ac:227,Th:232.04,Pa:231.04,U:238.03,
Np:237,Pu:244};   // 自包含原子量表（IUPAC 2013）
  const tfmt = (x) => String(Math.round(x * 100000) / 100000);
// SMILES → 元素计数（含隐式氢）。纯函数、无 DOM，可 node 测试，亦可注入页面。
function smilesCounts(input) {
  const s = String(input || '').trim();
  if (!s) throw 'Empty input';
  const MASS_OK = /^[A-Z][a-z]?$/;
  const ARO = { b:'B', c:'C', n:'N', o:'O', p:'P', s:'S' };
  const ORG1 = { B:1, C:1, N:1, O:1, P:1, S:1, F:1, I:1 };
  const ORG2 = { Cl:1, Br:1 };
  const VALENCE = { B:[3], C:[4], N:[3], O:[2], P:[3,5], S:[2,4,6], F:[1], Cl:[1], Br:[1], I:[1] };
  const A = [];            // {el, bs(键级和), h(括号原子显式H), aro}
  const rings = {};        // 开环表
  let prev = -1, pend = null;
  const stack = [];
  const bondAdd = (a, b, o) => { A[a].bs += o; A[b].bs += o; };
  const newAtom = (el, aro, h) => {
    const a = { el, bs: 0, h: (h === undefined ? null : h), aro: !!aro };
    A.push(a);
    const cur = A.length - 1;
    if (prev >= 0) bondAdd(prev, cur, (pend != null) ? pend : ((a.aro && A[prev].aro) ? 1.5 : 1));
    pend = null; prev = cur;
    return cur;
  };
  let i = 0;
  while (i < s.length) {
    const ch = s[i];
    if (ch === '(') { stack.push(prev); i++; continue; }
    if (ch === ')') { if (!stack.length) throw 'Unbalanced parentheses'; prev = stack.pop(); i++; continue; }
    if (ch === '.') { prev = -1; pend = null; i++; continue; }
    if (ch === '-' || ch === '/' || ch === '\\') { pend = 1; i++; continue; }
    if (ch === '=') { pend = 2; i++; continue; }
    if (ch === '#') { pend = 3; i++; continue; }
    if (ch === ':') { pend = 1.5; i++; continue; }
    if (ch === '%') {
      const m = s.slice(i + 1).match(/^(\d{2})/);
      if (!m) throw 'Bad ring closure (%nn)';
      const r = m[1];
      if (rings[r] !== undefined) { const o = rings[r]; delete rings[r]; bondAdd(o.atom, prev, (pend != null) ? pend : ((o.aro && A[prev].aro) ? 1.5 : 1)); }
      else { rings[r] = { atom: prev, aro: A[prev].aro, order: pend }; if (pend != null) pend = null; }
      pend = null; i += 1 + m[1].length; continue;
    }
    if (/\d/.test(ch)) {
      const r = ch;
      if (rings[r] !== undefined) { const o = rings[r]; delete rings[r]; bondAdd(o.atom, prev, (pend != null) ? pend : ((o.aro && A[prev].aro) ? 1.5 : ((o.order != null) ? o.order : 1))); }
      else { rings[r] = { atom: prev, aro: A[prev].aro, order: pend }; if (pend != null) pend = null; }
      pend = null; i++; continue;
    }
    if (ch === '[') {
      const j = s.indexOf(']', i);
      if (j < 0) throw 'Unclosed bracket atom';
      const body = s.slice(i + 1, j);
      let k = 0;
      while (k < body.length && /\d/.test(body[k])) k++;                     // 同位素（忽略，按天然丰度计）
      if (k >= body.length) throw 'Empty bracket atom';
      let sym = body[k]; k++;
      if (k < body.length && /[a-z]/.test(body[k])) { sym += body[k]; k++; } // 两字母符号
      let aro = false;
      if (sym[0] >= 'a' && sym[0] <= 'z') { aro = true; sym = (ARO[sym] !== undefined) ? ARO[sym] : sym[0].toUpperCase() + sym.slice(1); }
      if (!MASS_OK.test(sym)) throw 'Unknown element in brackets: ' + sym;
      if (body[k] === '@') { k++; if (body[k] === '@') k++; else { const m2 = body.slice(k).match(/^(TH|AL|SP|TB|OH)\d+/); if (m2) k += m2[1].length + 1; } }
      let h = 0;
      if (body[k] === 'H') { k++; let d = ''; while (k < body.length && /\d/.test(body[k])) { d += body[k]; k++; } h = d ? parseInt(d, 10) : 1; }
      let charge = 0;
      if (body[k] === '+' || body[k] === '-') {
        const sign = body[k] === '+' ? 1 : -1; k++;
        let d = ''; while (k < body.length && body[k] === body[k - 1] && (body[k] === '+' || body[k] === '-')) { d += body[k]; k++; }
        let n = ''; while (k < body.length && /\d/.test(body[k])) { n += body[k]; k++; }
        charge = n ? sign * parseInt(n, 10) : sign * (1 + d.length);
      }
      if (body[k] === ':') { k++; while (k < body.length && /\d/.test(body[k])) k++; }
      if (k !== body.length) throw 'Cannot parse bracket atom [' + body + ']';
      if (charge !== 0 && !aro) { /* 带电括号原子：H 已显式给出 */ }
      newAtom(sym, aro, h);
      i = j + 1; continue;
    }
    if (ORG2[ch] !== undefined && /[a-z]/.test(s[i + 1] || '')) { newAtom(ch, false, null); i += 2; continue; }
    if (ORG1[ch]) { newAtom(ch, false, null); i++; continue; }
    if (ARO[ch]) { newAtom(ARO[ch], true, null); i++; continue; }
    throw 'Unrecognized character: ' + ch;
  }
  if (stack.length) throw 'Unbalanced parentheses';
  if (!A.length) throw 'No atoms found';
  for (const r in rings) throw 'Unclosed ring bond: ' + r;
  // 隐式氢：非括号原子 = 最小可容纳价态 − 键级和；括号原子 = 显式 H
  const counts = {};
  for (const a of A) {
    let H;
    if (a.h !== null) H = a.h;
    else {
      const vl = VALENCE[a.el] || [];
      let v = null;
      for (const x of vl) if (x >= a.bs - 1e-9) { v = x; break; }
      H = (v === null) ? 0 : Math.round(v - a.bs);
    }
    if (H < 0) H = 0;
    counts[a.el] = (counts[a.el] || 0) + 1;
