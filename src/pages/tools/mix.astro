---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="配方计算器 · TubeCalc" active="mix.html" root="../"
  note="计算全部在浏览器本地进行"
>
  <Fragment slot="head">
    <style is:inline>

.mix-controls { display:flex; flex-wrap:wrap; gap:12px; align-items:flex-end; margin:14px 0 6px; }
.mix-controls label { display:flex; flex-direction:column; gap:4px; font-size:13px; color:var(--muted); }
.mix-total { display:flex; gap:8px; }
.mix-row { display:grid; grid-template-columns: minmax(110px,1.1fr) 1.5fr 1.5fr 1.2fr 44px; gap:10px; align-items:center;
  padding:10px 12px; border:1px solid var(--border); border-radius:11px; margin-top:10px; background:var(--card); }
.mix-row.water { background:var(--card); box-shadow: inset 3px 0 0 var(--accent); }   /* 同底色融入卡片流，仅左侧细蓝条标记溶剂身份 */
#solvSel { flex:0 0 auto; max-width:132px; background:var(--accent-soft); border-color:rgba(0,113,227,.35); font-weight:600; }
.solv-tag { font-size:12px; color:var(--muted); }
.ghost { flex:1; display:flex; align-items:center; justify-content:center; padding:11px 0; line-height:20px;
  border-radius:10px; color:var(--muted); font-size:16px; }   /* 占位框：与组分行输入框同高同宽，结构性列对齐 */
.ghost.g2 { background:rgba(94,92,230,.05); }
.ghost.g3 { background:rgba(34,165,180,.06); }
.mix-row.water .vol-out { flex:1; min-width:0; display:flex; align-items:center; height:42px; padding:0 14px;
  border-radius:12px; font-size:16px; background:rgba(255,159,10,.10); border:1px solid rgba(255,159,10,.40); }   /* 与组分行用量输入框同规格 */
.solv-mass { grid-column:1/-1; font-size:12px; color:var(--muted); font-variant-numeric:tabular-nums; }
.solv-mass:empty { display:none; }
.mix-head { font-size:12.5px; color:var(--muted); display:grid; grid-template-columns: minmax(110px,1.1fr) 1.5fr 1.5fr 1.2fr 44px; gap:10px; padding:0 12px; margin-top:18px; }
.mix-head span { display:flex; align-items:center; gap:6px; }
.mix-head span::before { content:''; flex:0 0 8px; width:8px; height:8px; border-radius:3px; background:currentColor; opacity:.35; }
.mix-head span:nth-child(2)::before { background:#5e5ce6; opacity:1; }
.mix-head span:nth-child(3)::before { background:#22a5b4; opacity:1; }
.mix-head span:nth-child(4)::before { background:#e8890c; opacity:1; }
.mix-head span:empty::before { display:none; }
.cell { display:flex; gap:6px; align-items:center; min-width:0; }
.ig { flex:1; display:flex; gap:6px; align-items:center; min-width:0; }
.ig input[type=text], .ig input[type=number], .ig select { min-width:0; flex:1; }
.ig select { flex:0 0 auto; max-width:92px; }
/* 自绘储液单位下拉：小标题（小字灰）→ 选项 → 当前选中（蓝+勾），三层视觉层次 */
.dd { position:relative; flex:0 0 auto; max-width:104px; }
.dd-btn { display:inline-flex; align-items:center; gap:5px; padding:11px 12px; font-size:16px; font-family:inherit;
  color:var(--text); background:var(--glass-strong); border:1px solid var(--border); border-radius:12px; outline:none;
  cursor:pointer; transition:border-color .15s ease, box-shadow .15s ease; white-space:nowrap; }
.dd-btn:focus-visible { border-color:var(--accent); box-shadow:0 0 0 4px var(--accent-soft); }
.dd-ar { font-size:10px; color:var(--muted); }
.dd-panel { display:none; position:absolute; top:calc(100% + 6px); right:0; z-index:40; min-width:172px; padding:6px;
  background:var(--card); backdrop-filter:blur(22px) saturate(1.5); -webkit-backdrop-filter:blur(22px) saturate(1.5);
  border:1px solid var(--border); border-radius:13px; box-shadow:0 14px 36px rgba(0,0,0,.17); }
.dd.open .dd-panel { display:block; }
.dd-sec { font-size:10.5px; font-weight:600; letter-spacing:.14em; color:var(--muted); padding:7px 10px 3px; }
.dd-sec:not(:first-child) { margin-top:5px; padding-top:9px; border-top:1px solid var(--border); }
.dd-it { display:block; width:100%; padding:7px 10px; border:0; border-radius:9px; background:none;
  font-size:14px; font-family:inherit; color:var(--text); text-align:left; cursor:pointer; }
.dd-it:hover { background:var(--accent-soft); }
.dd-it.cur { color:var(--accent); font-weight:600; background:var(--accent-soft); }
.dd-it.cur::after { content:'✓'; float:right; font-size:13px; font-weight:700; }
/* 列语义色：储液=紫（投入），终浓度=青（目标），用量=琥珀（结果） */
.c2 .ig input, .c2 .ig select, .c2 .ig .dd-btn { background:rgba(94,92,230,.07); border-color:rgba(94,92,230,.30); }
.c3 .ig input, .c3 .ig select { background:rgba(34,165,180,.08); border-color:rgba(34,165,180,.32); }
.c4 .ig input, .c4 .ig select { background:rgba(255,159,10,.10); border-color:rgba(255,159,10,.40); }
.c4 .ig input { font-weight:600; }
.c4 .ig input[readonly] { cursor:default; opacity:.9; }
.mix-row.water .vol-out { display:inline-block; padding:9px 12px; border-radius:10px; background:rgba(255,159,10,.10); border:1px solid rgba(255,159,10,.40); }
.vol-out { font-weight:600; font-variant-numeric:tabular-nums; }
.row-warn { color:var(--danger); font-size:12px; grid-column:1/-1; }
.del { border:1px solid var(--border); background:var(--card); color:var(--muted); border-radius:8px; cursor:pointer; height:38px; }
.del:hover { color:var(--danger); border-color:var(--danger); }
@media (max-width:760px){ .mix-head{display:none;} .mix-row{grid-template-columns:1fr 1fr;} .mix-row .cell.name{grid-column:1/3;} .mix-row .del{grid-column:2; justify-self:end;} .mix-row .row-warn{grid-column:1/3;}
  .cell{flex-direction:column; align-items:stretch; gap:4px;}
  .cell::before{content:attr(data-l); font-size:11px; font-weight:600; color:var(--muted);}
  .cell.name::before{color:var(--text);} .cell.c2::before{color:#7d7ce0;} .cell.c3::before{color:#1a97a8;} .cell.c4::before{color:#d97f06;} }
#mixWarn { margin-top:14px; }
.btn-ghost { background:transparent; border:1px solid var(--border); color:var(--text); }
    </style>
  </Fragment>

<main class="container">
  <h1 class="page-title">配方计算器</h1>
  <p class="page-desc">反应体系 / 母液配制：填"储液 → 终浓度"自动算加样量（V = C终 × V总 ÷ C储），支持 × 倍液、% v/v、% w/v 与粉末称量；浓度留空直接填用量即手动模式。溶剂自动补齐，数据自动保存在本浏览器。</p>

  <div class="mix-controls">
    <label>总体积
      <span class="mix-total"><input type="number" id="total" value="200" min="0" step="any" style="width:110px">
      <select id="totalUnit" style="width:74px"><option value="1">μL</option><option value="1000">mL</option></select></span>
    </label>
    <button class="btn" id="addRow">添加组分</button>
    <button class="btn btn-ghost" id="copyTsv">复制表格 (TSV)</button>
    <button type="button" class="demo-link" id="loadDemo" title="填入示例数据演示用法（会覆盖当前配方）">载入示例配方</button>
  </div>

  <div class="mix-head"><span>组分</span><span>储液 / 分子量</span><span>终浓度</span><span>用量</span><span></span></div>
  <div id="waterRow"></div>
  <div id="rows"></div>
  <div class="error" id="mixWarn"></div>
  <div class="hint" style="margin-top:12px">三列怎么填都行：<b>算体积</b> — 填储液浓度 + 终浓度（同量纲单位），用量自动算出；<b>算称量</b> — 第二列单位选 g/mol 填分子量、终浓度用 mol/L，或终浓度直接选 % w/v / mg/mL 等质量单位（无需分子量），用量列自动给出质量；<b>手动</b> — 浓度留空，直接在用量列填体积（μL/mL）或质量（mg/μg/g）。常用场景：× 倍液（储液选 × 后，终浓度单位自动限定为 ×，5×→1× 即取 V总/5）；乙醇等纯液（终浓度选 % v/v、储液不填按 100% 算，70% 即取 0.7×V总；从 95% 母液稀释则储液也选 % v/v 填 95）；琼脂糖/SDS 等（终浓度选 % w/v，1% = 10 g/L）。改浓度会重新自动计算；<b>同时填了储液与终浓度（或用质量浓度单位）时，用量数字自动算出并锁定，只允许调整单位</b>；手动填用量请清空终浓度。粉末/质量用量不占体积（溶解后定容）：涉及分子量/称量的配方直接显示"定容至总体积"，其余配方显示溶剂所需体积（= 总体积 − 各液态用量之和）。</div>
</main>

<footer><span class="foot-note">计算全部在浏览器本地进行</span><br>© 2026 <a href="../index.html">TubeCalc</a> · <a href="https://github.com/Othrik/TubeCalc" target="_blank" rel="noopener"><svg viewBox="0 0 16 16" width="15" height="15" fill="currentColor" style="vertical-align:-2px;margin-right:4px" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>GitHub</a></footer>

<script is:inline>
const LS_KEY = 'tubecalc_mix_v1';
const $ = (s, p) => (p || document).querySelector(s);
// 第二列单位（自绘分组下拉，三类）：浓度类母液（M 系 / × / 质量浓度）；纯液按体积分数 % v/v（留空=100%）；粉剂按 g/mol 称分子量
const SU = [
  ['溶液', [['1','M'], ['0.001','mM'], ['0.000001','μM'], ['1e-9','nM'], ['x','×'], ['pwv','% w/v'], ['gl','g/L'], ['mgml','mg/mL'], ['mgl','mg/L'], ['ugml','μg/mL'], ['ngml','ng/mL']]],
  ['纯液体', [['pvv','% v/v']]],
  ['固体', [['gmol','g/mol']]]
];
// 第三列单位：M 系=摩尔终浓度；×=倍液；% v/v=体积比；% w/v 与 g/L 系=质量浓度（可称粉或配母液稀释）
const FU = [['1','M'], ['0.001','mM'], ['0.000001','μM'], ['1e-9','nM'], ['x','×'], ['pvv','% v/v'], ['pwv','% w/v'], ['gl','g/L'], ['mgml','mg/mL'], ['mgl','mg/L'], ['ugml','μg/mL'], ['ngml','ng/mL']];
// 量纲与换算系数：M→mol/L；RX→体积比(×=1)；RV→体积分数(%v/v=0.01)；GL→g/L（% w/v = 10 g/L）
const SUD = { '1':['M',1], '0.001':['M',0.001], '0.000001':['M',1e-6], '1e-9':['M',1e-9], 'x':['RX',1], 'pvv':['RV',0.01], 'pwv':['GL',10], 'gmol':['MW',0], 'gl':['GL',1], 'mgml':['GL',1], 'mgl':['GL',0.001], 'ugml':['GL',0.001], 'ngml':['GL',1e-6] };
const FUD = { '1':['M',1], '0.001':['M',0.001], '0.000001':['M',1e-6], '1e-9':['M',1e-9], 'x':['RX',1], 'pvv':['RV',0.01], 'pwv':['GL',10], 'gl':['GL',1], 'mgml':['GL',1], 'mgl':['GL',0.001], 'ugml':['GL',0.001], 'ngml':['GL',1e-6] };
const MO = ['1','0.001','0.000001','1e-9'];   // 摩尔单位键
// 用量列单位：μL（体积，计入溶剂扣减）或质量（不占体积）
const AU = [['uL','μL'], ['ml','mL'], ['mg','mg'], ['ug','μg'], ['g','g']];
// 溶剂选项：键（语言无关，存 LS）→ 显示名 → 密度 g/mL（约 20 ℃；黏稠溶剂常按质量取用，非水溶剂显示质量参考）
const SOLV = [['water','水',1], ['ethanol','乙醇',0.789], ['methanol','甲醇',0.792], ['isopropanol','异丙醇',0.786], ['dmso','DMSO',1.10], ['glycerol','甘油',1.261], ['other','其他',0]];
let rows = [];
let solv = 'water';
let solvU = 'uL';   // 溶剂体积显示单位（μL/mL）
let useMWNow = false;   // 最近一次计算是否存在称量步骤（TSV 复原溶剂用量单位用）

function fmtVol(v) {
  if (!isFinite(v)) return '—';
  const a = Math.abs(v);
  return (a >= 100 ? v.toFixed(1) : a >= 1 ? v.toFixed(2) : v.toFixed(3));
}
function fmtConc(v) {
  const a = Math.abs(v);
  return (a >= 100 ? v.toFixed(1) : a >= 1 ? v.toFixed(2) : a >= 0.001 ? v.toFixed(4) : v.toExponential(2));
}
function fmtMass(g) { return g >= 1 ? g.toFixed(2) + ' g' : Math.round(g * 1000) + ' mg'; }
const esc = s => String(s).replace(/[&<>"]/g, c => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;' }[c]));
function rowVol(r, res) {   // 该行占用的体系体积（μL；质量行不占体积）
  if (isFinite(res.v)) return res.v;
  if (isFinite(res.m)) return 0;
  const a = parseFloat(r.amt);
  return (isFinite(a) && r.au === 'uL') ? a : (isFinite(a) && r.au === 'ml') ? a * 1000 : 0;
}
function totalUpt() { return (parseFloat($('#total').value) || 0) * parseFloat($('#totalUnit').value); }

function demo() {
  return { total: 200, totalUnit: '1', rows: [
    { name:'Tris-HCl pH 8.0',        sv:1,     su:'1',    fv:75,  fu:'0.001' },
    { name:'NaCl',                   sv:5,     su:'1',    fv:75,  fu:'0.001' },
    { name:'TCEP',                   sv:120,   su:'0.001',fv:1.2, fu:'0.001' },
    { name:'TMR-LPETG',              sv:1,     su:'0.001',fv:10,  fu:'0.000001' },
    { name:'Cargo（GGA-PSP）',        sv:144.1, su:'1e-9', fv:2.5, fu:'1e-9' },
    { name:'SortaseA（SRT7plus）',    sv:265.2, su:'1e-9', fv:0.5, fu:'1e-9' },
    { name:'superTEV',               sv:24.9,  su:'1e-9', fv:1,   fu:'1e-9' },
    { name:'QtEnc',                  sv:'',    su:'1',    fv:'',  fu:'1', amt:'', au:'uL' }
  ]};
}

function sel(list, val, cls) {
  const opt = u => '<option value="' + u[0] + '"' + (u[0] === val ? ' selected' : '') + (u[2] ? ' disabled' : '') + '>' + u[1] + '</option>';
  const grouped = list.length && Array.isArray(list[0][1]);   // [组名, [选项...]] 还是平铺 [值, 名, 禁用]
  return '<select class="' + cls + '">' + (grouped
    ? list.map(g => '<optgroup label="' + g[0] + '">' + g[1].map(opt).join('') + '</optgroup>').join('')
    : list.map(opt).join('')) + '</select>';
}

function dd(groups, val, cls) {   // 自绘分组下拉（储液单位专用：小标题+选项+当前勾选）
  const flat = groups.flatMap(g => g[1]);
  const cur = flat.find(u => u[0] === val) || flat[0];
  return '<div class="dd ' + cls + '-dd">' +
    '<button type="button" class="dd-btn" aria-haspopup="listbox">' + cur[1] + '<span class="dd-ar">▾</span></button>' +
    '<div class="dd-panel">' + groups.map(g =>
      '<div class="dd-sec">' + g[0] + '</div>' + g[1].map(u =>
        '<button type="button" class="dd-it' + (u[0] === cur[0] ? ' cur' : '') + '" data-v="' + u[0] + '">' + u[1] + '</button>').join('')
    ).join('') + '</div></div>';
}

function render() {
  $('#waterRow').innerHTML = '<div class="mix-row water"><div class="cell name" data-l="组分"><div class="ig">' +
    '<select id="solvSel" aria-label="溶剂">' + SOLV.map(s => '<option value="' + s[0] + '"' + (s[0] === solv ? ' selected' : '') + '>' + s[1] + '</option>').join('') + '</select><span class="solv-tag">溶剂</span></div></div>' +
    '<div class="cell" data-l="储液 / 分子量"><span class="ghost g2">—</span></div><div class="cell" data-l="终浓度"><span class="ghost g3">—</span></div><div class="cell c4" data-l="用量"><div class="ig"><span class="vol-out" id="waterVol">—</span><select id="solvU" aria-label="溶剂单位"><option value="uL"' + (solvU === 'uL' ? ' selected' : '') + '>μL</option><option value="ml"' + (solvU === 'ml' ? ' selected' : '') + '>mL</option></select></div></div><div></div>' +
    '<div class="solv-mass" id="waterMass"></div></div>';
  $('#solvSel').addEventListener('change', () => { solv = $('#solvSel').value; changed(); });
  $('#solvU').addEventListener('change', () => { solvU = $('#solvU').value; changed(); });
  const box = $('#rows'); box.innerHTML = '';
  rows.forEach((r, i) => {
    if (r.su === 'x' && r.fu !== 'x') { r.fu = 'x'; r.fv = ''; }   // 储液选 × → 终浓度限 ×（含旧数据归一）
    const fuList = r.su === 'x' ? FU.map(u => u[0] === 'x' ? u : [u[0], u[1], true]) : FU;   // 储液×：其他单位置灰禁选
    const d = document.createElement('div');
    d.className = 'mix-row';
    d.innerHTML =
      '<div class="cell name" data-l="组分"><div class="ig"><input type="text" data-k="name" placeholder="组分名" value="' + (r.name || '').replace(/"/g, '&quot;') + '"></div></div>' +
      '<div class="cell c2" data-l="储液 / 分子量"><div class="ig"><input type="number" data-k="sv" placeholder="储液浓度 / 分子量" min="0" step="any" value="' + r.sv + '">' + dd(SU, r.su, 'su') + '</div></div>' +
      '<div class="cell c3" data-l="终浓度"><div class="ig"><input type="number" data-k="fv" placeholder="终浓度（可空）" min="0" step="any" value="' + r.fv + '">' + sel(fuList, r.fu, 'fu') + '</div></div>' +
      '<div class="cell c4" data-l="用量"><div class="ig"><input type="number" data-k="amt" placeholder="μL / mL / mg" min="0" step="any" value="' + (r.amt || '') + '">' + sel(AU, r.au || 'uL', 'au') + '</div></div>' +
      '<button class="del" data-del title="删除该组分">×</button>' +
      '<div class="hint" data-inv style="grid-column:1/-1"></div>';
    d.querySelectorAll('[data-k]').forEach(el => el.addEventListener('input', () => {
      r[el.dataset.k] = el.value;
      changed();
    }));
    const suDD = $('.su-dd', d);
    $('.dd-btn', suDD).addEventListener('click', e => {
      e.stopPropagation();
      document.querySelectorAll('.dd.open').forEach(x => { if (x !== suDD) x.classList.remove('open'); });
      suDD.classList.toggle('open');
    });
    suDD.querySelectorAll('.dd-it').forEach(it => it.addEventListener('click', () => {
      r.su = it.dataset.v;
      if (r.su === 'x' && r.fu !== 'x') { r.fu = 'x'; r.fv = ''; }   // 切到 ×：终浓度自动并锁定为 ×，清值防误读
      render();                                                     // 重建行以更新第三列可选项
    }));
    d.querySelectorAll('select').forEach(el => el.addEventListener('change', () => {
      r[el.className] = el.value;
      changed();
    }));
    $('[data-del]', d).addEventListener('click', () => { rows.splice(i, 1); render(); });
    box.appendChild(d);
  });
  changed();
}

function changed() { updateOutputs(); persist(); }

// 返回该行计算结果：{v:体积μL} 或 {m:质量g}，或 {} 表示手动/不计算
function calcRow(r, vt) {
  const fvN = parseFloat(r.fv), svN = parseFloat(r.sv);
  if (!(r.fv !== '' && r.fv != null && isFinite(fvN))) return {};   // 终浓度留空 → 手动用量
  const fd = FUD[r.fu] || ['M', 1], cls = fd[0], ff = fd[1];
  const sd = SUD[r.su] || null;
  const hasS = r.sv !== '' && r.sv != null && isFinite(svN) && svN > 0;
  const hi = (cfv, csv) => cfv > csv ? '终浓度高于储液浓度，无法配制' : '';
  if (cls === 'M') {                                                 // 摩尔终浓度
    if (sd && sd[0] === 'M' && hasS) {
      const cf = fvN * ff, cs = svN * sd[1];
      return { v: cf * vt / cs, warn: hi(cf, cs) };
    }
    if (sd && sd[0] === 'MW') {
      if (!hasS) return { warn: '需填分子量数值；若手动定量，请清空终浓度直接填用量' };
      return { m: fvN * ff * vt / 1e6 * svN };                       // mol/L × L × g/mol = g
    }
    if (!sd || !hasS) return { warn: '需填储液浓度，或第二列选 g/mol 填分子量；手动定量则清空终浓度' };
    return { warn: '储液与终浓度单位不匹配（' + (r.su === 'x' ? '×' : r.su === 'pvv' ? '% v/v' : '% w/v') + ' 与摩尔浓度）' };
  }
  if (cls === 'RX') {                                                // × 倍液
    if (sd && sd[0] === 'RX' && hasS) {
      const cf = fvN * ff, cs = svN * sd[1];
      return { v: cf * vt / cs, warn: hi(cf, cs) };
    }
    return { warn: '×（倍数）需储液与终浓度同时使用 ×' };
  }
  if (cls === 'RV') {                                                // % v/v 体积比
    if (sd && sd[0] === 'RV' && hasS) {
      const cf = fvN * ff, cs = svN * sd[1];
      return { v: cf * vt / cs, warn: hi(cf, cs) };
    }
    if (!sd || !hasS) return { v: fvN * ff * vt };                   // 不填储液 → 按 100% 纯液
    return { warn: '% v/v 需储液也是 % v/v，或不填储液按 100% 纯液算' };
  }
  // cls GL — 质量浓度终浓度（g/L 系与 % w/v）
  if (sd && sd[0] === 'GL' && hasS) {                                // 储液也是质量浓度（母液稀释）→ 体积
    const cf = fvN * ff, cs = svN * sd[1];
    return { v: cf * vt / cs, warn: hi(cf, cs) };
  }
  if (sd && sd[0] === 'M' && hasS) return { warn: '储液是摩尔浓度：请改用质量浓度单位填储液，或第二列改 g/mol 填分子量、终浓度用 mol/L' };
  if (sd && sd[0] === 'RX' && hasS) return { warn: '×（倍数）不能与质量浓度混用' };
  return { m: fvN * ff * vt / 1e6 };                                 // 称粉（储液未填数值时分子量忽略）：g/L × L = g
}

function updateOutputs() {
  const vt = totalUpt();
  let sum = 0, useMW = false;   // useMW：存在称量/涉分子量步骤 → 水量后提示定容
  document.querySelectorAll('#rows .mix-row').forEach((d, i) => {
    const r = rows[i];
    const res = calcRow(r, vt);
    const warn = res.warn || '';
    if (r.su === 'gmol' || isFinite(res.m)) useMW = true;
    const amtIn = $('[data-k=amt]', d), auSel = $('select.au', d);
    const canV = isFinite(res.v), canM = isFinite(res.m);
    // 用量列：浓度齐全 → 数字自动算出并锁定（只读），仅允许调整单位
    if (canV) {
      if (auSel.value !== 'uL' && auSel.value !== 'ml') auSel.value = 'uL';   // 质量残留值归位体积
      const div = auSel.value === 'ml' ? 1000 : 1;
      if (amtIn.value !== fmtVol(res.v / div)) amtIn.value = fmtVol(res.v / div);
      r.amt = amtIn.value;
      r.au = auSel.value;
    } else if (canM) {
      const m = res.m, u = auSel.value;
      let txt;
      if (u === 'g') txt = m.toFixed(3);
      else if (u === 'mg') txt = (m * 1e3).toFixed(3);
      else if (u === 'ug') txt = (m * 1e6).toFixed(3);
      else { const pair = m >= 1 ? ['g', m.toFixed(3)] : m * 1e3 >= 1 ? ['mg', (m * 1e3).toFixed(3)] : ['ug', (m * 1e6).toFixed(3)]; auSel.value = pair[0]; txt = pair[1]; }
      r.au = auSel.value;
      if (amtIn.value !== txt) amtIn.value = txt;
      r.amt = txt;
    }
    const auto = canV || canM;
    if (amtIn.readOnly !== auto) amtIn.readOnly = auto;
    amtIn.title = auto ? '用量由浓度自动算出（数字锁定，可换单位）；手动填写请清空终浓度' : '';
    Array.prototype.forEach.call(auSel.options, o => {
      const isVol = o.value === 'uL' || o.value === 'ml';
      o.disabled = canV ? !isVol : canM ? isVol : false;
    });
    // 计入溶剂扣减的体积
    sum += rowVol(r, res);
    // 行下反显提示
    const inv = $('[data-inv]', d);
    let tip = '';
    if (!isFinite(res.v) && !isFinite(res.m) && !warn) {
      const a = parseFloat(r.amt);
      if (isFinite(a) && a > 0 && (r.au === 'uL' || r.au === 'ml') && r.sv !== '' && r.fv === '') {
        const aU = r.au === 'ml' ? a * 1000 : a;   // 折算提示统一用 μL
        if (MO.includes(r.su)) {
          tip = '按当前储液折算终浓度 ≈ ' + fmtConc(parseFloat(r.sv) * parseFloat(r.su) * aU / vt) + ' M';
        } else if (r.su === 'x') {
          tip = '按当前储液折算终浓度 ≈ ' + fmtConc(parseFloat(r.sv) * aU / vt) + ' ×';
        } else if (r.su === 'pwv' || r.su === 'pvv') {
          tip = '按当前储液折算终浓度 ≈ ' + fmtConc(parseFloat(r.sv) * aU / vt) + (r.su === 'pwv' ? ' % w/v' : ' % v/v');
        }
      }
    }
    inv.textContent = tip;
    let w = $('.row-warn', d);
    if (warn && !w) { w = document.createElement('div'); w.className = 'row-warn'; d.appendChild(w); }
    if (w) w.textContent = warn;
  });
  const water = vt - sum;
  const wv = $('#waterVol'), wm = $('#waterMass');
  useMWNow = useMW;
  $('#solvU').style.display = useMW ? 'none' : '';
  if (water >= 0) {
    const totalStr = (($('#total').value || '0') + ' ' + (parseFloat($('#totalUnit').value) === 1000 ? 'mL' : 'μL')).replace(/^0+(\d)/, '$1');
    wv.textContent = useMW ? '定容至 ' + totalStr : fmtVol(water / (solvU === 'ml' ? 1000 : 1));
  } else {
    wv.textContent = '—';
  }
  wv.style.color = water < 0 ? 'var(--danger)' : '';
  // 非水溶剂附质量参考（黏稠溶剂常按质量取用）；水密度=1 与体积等值不显示，其他无密度
  const sd = SOLV.find(s => s[0] === solv);
  wm.textContent = (!useMW && water > 0 && sd && sd[2] && sd[2] !== 1) ? '≈ ' + fmtMass(water / 1000 * sd[2]) : '';
  $('#mixWarn').textContent = water < 0 ? ('溶剂为负：液态组分总体积已达 ' + fmtVol(sum) + ' μL，超过总体系 ' + fmtVol(vt) + ' μL，请调整') : '';
}

function persist() {
  const clean = rows.map(r => ({ name: r.name || '', sv: r.sv || '', su: r.su || '1', fv: r.fv || '', fu: r.fu || '1', amt: r.amt || '', au: r.au || 'uL' }));
  try { localStorage.setItem(LS_KEY, JSON.stringify({ total: $('#total').value, totalUnit: $('#totalUnit').value, solv, solvU, rows: clean })); } catch (e) {}
}
function restore() {
  try {
    const s = JSON.parse(localStorage.getItem(LS_KEY));
    if (s && Array.isArray(s.rows)) {
      $('#total').value = s.total; $('#totalUnit').value = s.totalUnit;
      solv = (s.solv && SOLV.some(x => x[0] === s.solv)) ? s.solv : 'water';
      solvU = (s.solvU === 'ml') ? 'ml' : 'uL';
      rows = s.rows.map(r => {
        const o = { name:'', sv:'', su:'1', fv:'', fu:'1', amt:'', au:'uL', _lock:false };
        Object.assign(o, r);
        if (r.type === 'powder') { o.sv = r.mw || ''; o.su = 'gmol'; }              // 旧粉末行 → 分子量
        if (r.type === 'fixed')  { o.amt = r.vol || ''; o._lock = true; }           // 旧定体积行 → 手动用量
        delete o.type; delete o.vol; delete o.mw; delete o._v; delete o._m;
        return o;
      });
      return true;
    }
  } catch (e) {}
  return false;
}

$('#total').addEventListener('input', changed);
$('#totalUnit').addEventListener('change', changed);
$('#addRow').addEventListener('click', () => { rows.push({ name:'', sv:'', su:'1', fv:'', fu:'1', amt:'', au:'uL' }); render(); });
$('#loadDemo').addEventListener('click', () => { const d = demo(); $('#total').value = d.total; $('#totalUnit').value = d.totalUnit; rows = d.rows.map(r => Object.assign({ amt:'', au:'uL', _lock:false }, r)); render(); });
$('#copyTsv').addEventListener('click', function () {
  const SUL = {'1':' M','0.001':' mM','0.000001':' μM','1e-9':' nM','x':'×','pvv':' % v/v','pwv':' % w/v','gmol':' g/mol'};
  const FUL = {'1':' M','0.001':' mM','0.000001':' μM','1e-9':' nM','x':'×','pvv':' % v/v','pwv':' % w/v','gl':' g/L','mgml':' mg/mL','mgl':' mg/L','ugml':' μg/mL','ngml':' ng/mL'};
  const AUL = {'uL':' μL','ml':' mL','mg':' mg','ug':' μg','g':' g'};
  const wUnit = (useMWNow || $('#waterVol').textContent === '—') ? '' : (solvU === 'ml' ? ' mL' : ' μL');
  let out = '组分\t储液/分子量\t终浓度\t用量\n' + $('#solvSel').selectedOptions[0].textContent + '（溶剂）\t—\t—\t' + $('#waterVol').textContent + wUnit + ($('#waterMass').textContent ? ' ' + $('#waterMass').textContent : '') + '\n';
  rows.forEach(r => {
    const cs = (r.sv === '' || r.sv == null) ? '—' : r.sv + (SUL[r.su] || '');
    const cf = (r.fv === '' || r.fv == null) ? '—' : r.fv + (FUL[r.fu] || '');
    const amt = (r.amt === '' || r.amt == null) ? '—' : r.amt + (AUL[r.au] || ' μL');
    out += [r.name || '未命名', cs, cf, amt].join('\t') + '\n';
  });
  const btn = $('#copyTsv'), t = btn.textContent;
  const done = () => { btn.textContent = '已复制'; setTimeout(() => btn.textContent = t, 1200); };
  (navigator.clipboard ? navigator.clipboard.writeText(out) : Promise.reject()).catch(() => {
    const ta = document.createElement('textarea'); ta.value = out; document.body.appendChild(ta);
    ta.select(); document.execCommand('copy'); document.body.removeChild(ta);
  }).finally(done);
});

document.addEventListener('click', () => document.querySelectorAll('.dd.open').forEach(x => x.classList.remove('open')));
document.addEventListener('keydown', e => { if (e.key === 'Escape') document.querySelectorAll('.dd.open').forEach(x => x.classList.remove('open')); });
if (!restore()) rows = [{ name:'', sv:'', su:'1', fv:'', fu:'1', amt:'', au:'uL' }];
render();
</script>

</Layout>
