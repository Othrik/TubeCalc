---
import Layout from '../../layouts/Layout.astro';
---

<Layout active="mw" title="分子量计算器 · TubeCalc"
  note="相对原子质量采用 IUPAC 标准值（四位有效以上）"
>

<main class="container">
  <h1 class="page-title">分子量计算器</h1>
  <p class="page-desc">输入化学式即可得到摩尔质量与元素组成。支持括号嵌套与水合物写法。</p>

  <div class="panel">
    <label for="formula">化学式</label>
    <input type="text" id="formula" placeholder="例如：C6H12O6 或 CuSO4·5H2O 或 (NH4)2SO4" autocomplete="off">
    <div class="hint">分隔符支持 · 、. 、*（如 CuSO4·5H2O）；元素符号区分大小写。</div>
    <button class="btn" id="calcBtn">计算</button>
    <span class="hint" style="display:inline-block;margin-left:10px">
      试一试：
      <a href="#" class="eg" data-f="C6H12O6">C6H12O6</a> ·
      <a href="#" class="eg" data-f="CuSO4·5H2O">CuSO4·5H2O</a> ·
      <a href="#" class="eg" data-f="(NH4)2SO4">(NH4)2SO4</a> ·
      <a href="#" class="eg" data-f="Ca(OH)2">Ca(OH)2</a>
    </span>
    <div class="error" id="err"></div>
  </div>

  <div class="panel result" id="resultPanel" style="display:none">
    <label>摩尔质量</label>
    <div class="big-number"><span id="mwVal"></span><small>g/mol</small></div>
    <div id="compTable"></div>
  </div>

  <div class="panel result" id="convPanel" style="display:none">
    <label>质量 ⇌ 摩尔换算（使用上方摩尔质量）</label>
    <div class="row">
      <div>
        <label for="massIn">质量 m (g)</label>
        <input type="number" id="massIn" step="any" placeholder="留空则按摩尔计算质量">
      </div>
      <div>
        <label for="molIn">物质的量 n (mol)</label>
        <input type="number" id="molIn" step="any" placeholder="留空则按质量计算摩尔">
      </div>
    </div>
    <div class="big-number" id="convOut" style="font-size:20px"></div>
  </div>
</main>


<script is:inline>
'use strict';
const MASS = {H:1.008,He:4.0026,Li:6.94,Be:9.0122,B:10.81,C:12.011,N:14.007,O:15.999,F:18.998,
Ne:20.180,Na:22.990,Mg:24.305,Al:26.982,Si:28.085,P:30.974,S:32.06,Cl:35.45,Ar:39.948,
K:39.098,Ca:40.078,Sc:44.956,Ti:47.867,V:50.942,Cr:51.996,Mn:54.938,Fe:55.845,Co:58.933,
Ni:58.693,Cu:63.546,Zn:65.38,Ga:69.723,Ge:72.630,As:74.922,Se:78.971,Br:79.904,Kr:83.798,
Rb:85.468,Sr:87.62,Y:88.906,Zr:91.224,Nb:92.906,Mo:95.95,Tc:98,Ru:101.07,Rh:102.91,
Pd:106.42,Ag:107.87,Cd:112.41,In:114.82,Sn:118.71,Sb:121.76,Te:127.60,I:126.90,Xe:131.29,
Cs:132.91,Ba:137.33,La:138.91,Ce:140.12,Pr:140.91,Nd:144.24,Pm:145,Sm:150.36,Eu:151.96,
Gd:157.25,Tb:158.93,Dy:162.50,Ho:164.93,Er:167.26,Tm:168.93,Yb:173.05,Lu:174.97,Hf:178.49,
Ta:180.95,W:183.84,Re:186.21,Os:190.23,Ir:192.22,Pt:195.08,Au:196.97,Hg:200.59,Tl:204.38,
Pb:207.2,Bi:208.98,Po:209,At:210,Rn:222,Fr:223,Ra:226,Ac:227,Th:232.04,Pa:231.04,U:238.03,
Np:237,Pu:244};

// 解析一个片段（不含水合物分隔符），返回元素计数对象
function parseSegment(seg) {
  let i = 0, mult = 1;
  const m = seg.match(/^\s*(\d+)/);
  if (m) { mult = parseInt(m[1], 10); i = m[1].length; }
  const counts = {};
  const stack = [counts];
  let stackTop = 0;
  while (i < seg.length) {
    const ch = seg[i];
    if (ch === '(') { stack.push({}); stackTop++; i++; }
    else if (ch === ')') {
      if (stackTop === 0) throw '括号不匹配';
      i++;
      let j = i; while (j < seg.length && /\d/.test(seg[j])) j++;
      const n = (j > i) ? parseInt(seg.slice(i, j), 10) : 1;
      const group = stack.pop(); stackTop--;
      const top = stack[stackTop];
      for (const el in group) top[el] = (top[el] || 0) + group[el] * n;
      i = j;
    }
    else if (/[A-Z]/.test(ch)) {
      let sym = ch;
      if (i + 1 < seg.length && /[a-z]/.test(seg[i + 1])) { sym += seg[i + 1]; }
      if (!(sym in MASS)) throw '无法识别的元素符号：' + sym;
      i += sym.length;
      let j = i; while (j < seg.length && /\d/.test(seg[j])) j++;
      const n = (j > i) ? parseInt(seg.slice(i, j), 10) : 1;
      const top = stack[stackTop];
      top[sym] = (top[sym] || 0) + n;
      i = j;
    }
    else if (/[a-z]/.test(ch)) { throw '元素符号位置出现小写字母（' + ch + '），请检查大小写'; }
    else { throw '无法识别的字符：' + ch; }
  }
  if (stackTop !== 0) throw '括号不匹配';
  if (mult > 1) for (const el in counts) counts[el] *= mult;
  if (Object.keys(counts).length === 0) throw '存在空的片段';
  return counts;
}

function parseFormula(input) {
  const segs = input.split(/[·.\*]/);
  const total = {};
  for (const seg of segs) {
    if (!seg.trim()) throw '存在空的片段（检查分隔符）';
    const c = parseSegment(seg);
    for (const el in c) total[el] = (total[el] || 0) + c[el];
  }
  return total;
}

function fmt(x) {
  return Math.abs(x - Math.round(x)) < 1e-9 ? String(Math.round(x)) : String(Math.round(x * 10000) / 10000);
}

function calc() {
  const input = document.getElementById('formula').value.trim();
  const err = document.getElementById('err');
  err.textContent = '';
  if (!input) { err.textContent = '请输入化学式'; return; }
  let counts;
  try { counts = parseFormula(input); } catch (e) { err.textContent = String(e); return; }
  let mw = 0; const rows = [];
  for (const el in counts) { const sub = MASS[el] * counts[el]; mw += sub;
    rows.push([el, counts[el], MASS[el], sub]); }
  rows.sort((a, b) => b[3] - a[3]);
  document.getElementById('mwVal').textContent = fmt(Math.round(mw * 100000) / 100000);
  let html = '<table class="tbl"><tr><th>元素</th><th>原子数</th><th>相对原子质量</th><th>贡献 (g/mol)</th></tr>';
  for (const r of rows) html += '<tr><td>' + r[0] + '</td><td>' + r[1] + '</td><td>' + r[2] + '</td><td>' + fmt(r[3]) + '</td></tr>';
  html += '</table>';
  document.getElementById('compTable').innerHTML = html;
  document.getElementById('resultPanel').style.display = '';
  document.getElementById('convPanel').style.display = '';
  document.getElementById('massIn').dispatchEvent(new Event('input'));
}

document.getElementById('calcBtn').addEventListener('click', calc);
document.getElementById('formula').addEventListener('keydown', e => { if (e.key === 'Enter') calc(); });
document.querySelectorAll('.eg').forEach(a => a.addEventListener('click', e => {
  e.preventDefault();
  document.getElementById('formula').value = a.dataset.f;
  calc();
}));

// 质量 ⇌ 摩尔换算
function convertMassMol() {
  const mw = parseFloat(document.getElementById('mwVal').textContent);
  if (!mw) return;
  const mIn = document.getElementById('massIn'), nIn = document.getElementById('molIn');
  const m = parseFloat(mIn.value), n = parseFloat(nIn.value);
  const out = document.getElementById('convOut');
  const editingMass = document.activeElement === mIn;
  const editingMol = document.activeElement === nIn;
  if (editingMass && isFinite(m) && m > 0) {
    nIn.value = (Math.round(m / mw * 1e6) / 1e6);
    out.textContent = nIn.value + ' mol ⇌ ' + m + ' g';
  } else if (editingMol && isFinite(n) && n > 0) {
    mIn.value = (Math.round(n * mw * 1e6) / 1e6);
    out.textContent = mIn.value + ' g ⇌ ' + n + ' mol';
  }
}
document.getElementById('massIn').addEventListener('input', convertMassMol);
document.getElementById('molIn').addEventListener('input', convertMassMol);
</script>

</Layout>
