---
import Layout from '../../../layouts/Layout.astro';
---

<Layout active="mol" lang="pt" title="Ferramentas moleculares · TubeCalc"
  note="Princípio: massa molar = Σ(peso atómico × número de átomos), com parênteses e hidratos; pesos atómicos segundo valores padrão IUPAC. Referência: Meija J, Coplen TB, Berglund M, et al. Atomic weights of the elements 2013. Pure Appl Chem. 2016;88(3):265-91."
>

<main class="container">
  <h1 class="page-title">Ferramentas moleculares</h1>
  <p class="page-desc">Escreve uma fórmula química (parênteses aninhados e hidratos), uma cadeia SMILES ou o nome do composto — o tipo é detetado automaticamente; SMILES e nomes também desenham a estrutura 2D.</p>

  <div class="panel">
    <label for="q">Fórmula · SMILES · nome — deteção automática</label>
    <input type="text" id="q" placeholder="p. ex. C6H12O6, CuSO4·5H2O, CC(=O)Oc1ccccc1C(=O)O ou «cafeína»" autocomplete="off" autocapitalize="none" autocorrect="off" spellcheck="false">
    <div class="hint">Uma só caixa para tudo: fórmulas químicas (parênteses e hidratos), estruturas SMILES ou nomes de compostos via PubChem — o tipo de entrada é detetado automaticamente.</div>
    <button class="btn" id="calcBtn">Calcular</button>
    <span class="hint" style="display:inline-block;margin-left:10px">Experimente:
      <a href="#" class="eg" data-f="C6H12O6">C6H12O6</a> · <a href="#" class="eg" data-f="CuSO4·5H2O">CuSO4·5H2O</a> · <a href="#" class="eg" data-f="(NH4)2SO4">(NH4)2SO4</a> · <a href="#" class="eg" data-f="Ca(OH)2">Ca(OH)2</a> · <a href="#" class="eg-s" data-s="CC(=O)Oc1ccccc1C(=O)O">Aspirina</a> · <a href="#" class="eg-s" data-s="CN1C=NC2=C1C(=O)N(C(=O)N2C)C">Cafeína</a> · <a href="#" class="eg-s" data-s="OC[C@H]1O[C@H](O)[C@H](O)[C@H](O)[C@H]1O">Glicose</a> · <a href="#" class="eg-s" data-s="NC(CO)(CO)CO">Tris</a> · <a href="#" class="eg-s" data-s="OC(=O)CN(CCN(CC(=O)O)CC(=O)O)CC(=O)O">EDTA</a>
    </span>
    <div class="error" id="err"></div>
    <div class="hint" style="margin-top:8px">Pesquisas de estruturas e nomes cortesia do <a href="https://pubchem.ncbi.nlm.nih.gov/" target="_blank" rel="noopener">PubChem</a> (NCBI).</div>

</div>

  <div class="panel result" id="resultPanel" style="display:none">
    <div class="res-head"><div class="hint" id="modeBadge"></div><div class="dl-wrap" id="dlWrap" style="display:none"><button class="btn" id="dlBtn">Descarregar &#9662;</button><div class="dl-menu" id="dlMenu"><button class="dl-item" data-fmt="svg">SVG</button><button class="dl-item" data-fmt="png">PNG</button><button class="dl-item" data-fmt="jpeg">JPEG</button><button class="dl-item" data-fmt="webp">WebP</button></div></div></div>
<div class="struct-wrap" id="structWrap" style="display:none"><div id="structSvg"></div></div>
    <div class="hint" id="sVia" style="display:none;margin-top:8px"></div>
    <label style="margin-top:12px">Massa molar</label>
    <div class="big-number"><span id="mwVal"></span><small>g/mol</small></div>
    <div class="hint" id="fLine" style="margin-top:8px"></div>
    <div id="compTable"></div>
    <div id="molInfo" class="mol-info" style="display:none"></div>
  </div>

  <div class="panel result" id="convPanel" style="display:none">
    <label>Conversão massa ⇌ moles (usa a massa molar acima)</label>
    <div class="row">
      <div>
        <label for="massIn">Massa m (g)</label>
        <input type="number" inputmode="decimal" id="massIn" step="any" placeholder="Deixe vazio para calcular a massa a partir dos moles">
      </div>
      <div>
        <label for="molIn">Quantidade n (mol)</label>
        <input type="number" inputmode="decimal" id="molIn" step="any" placeholder="Deixe vazio para calcular os moles a partir da massa">
      </div>
    </div>
    <div class="big-number" id="convOut" style="font-size:20px"></div>
  </div>


  <style is:inline>
.struct-wrap{border:1px solid var(--border);border-radius:12px;background:#fff;padding:12px;margin-top:14px;display:flex;justify-content:center}
.struct-wrap svg{max-width:100%;height:auto}
  </style>
</main>


<script is:inline>
'use strict';
const MASS = {H:1.008,He:4.0026,Li:6.94,Be:9.0122,B:10.81,C:12.011,N:14.007,O:15.999,F:18.998,
Ne:20.180,Na:22.990,Mg:24.305,Al:26.982,Si:28.085,P:30.974,S:32.06,Cl:35.45,Ar:39.948,
K:39.098,Ca:40.078,Sc:44.956,Ti:47.867,V:50.942,Cr:51.996,Mn:54.938,Fe:55.845,Co:58.933,
Ni:58.693,Cu:63.546,Zn:65.38,Ga:69.723,Ge:72.630,As:74.922,Se:78.971,Br:79.904,Kr:83.798,
Rb:85.468,Sr:87.62,Y:88.906,Zr:91.224,Nb:92.906,Mo:95.95,Tc:98,Ru:101.07,Rh:102.91,
Pd:106.42,Ag:107.87,Cd:112.41,In:114.82,Sn:118.71,Sb:121.76,Te:127.60,I:126.90,Xe:131.29,
Cs:132.91,Ba:137.33,La:138.91,Ce:140.12,Pr:140.91,Nd:144.24,Pm:145,Sm:150.36,Eu:151.96,
Gd:157.25,Tb:158.93,Dy:162.50,Ho:164.93,Er:167.26,Tm:168.93,Yb:173.05,Lu:174.97,Hf:178.49,
Ta:180.95,W:183.84,Re:186.21,Os:190.23,Ir:192.22,Pt:195.08,Au:196.97,Hg:200.59,Tl:204.38,
Pb:207.2,Bi:208.98,Po:209,At:210,Rn:222,Fr:223,Ra:226,Ac:227,Th:232.04,Pa:231.04,U:238.03,
Np:237,Pu:244};

// 解析一个片段（不含水合物分隔符），返回元素计数对象
function parseSegment(seg) {
  let i = 0, mult = 1;
  const m = seg.match(/^\s*(\d+)/);
  if (m) { mult = parseInt(m[1], 10); i = m[1].length; }
  const counts = {};
  const stack = [counts];
  let stackTop = 0;
  while (i < seg.length) {
    const ch = seg[i];
    if (ch === '(') { stack.push({}); stackTop++; i++; }
    else if (ch === ')') {
      if (stackTop === 0) throw 'Parênteses sem par';
      i++;
      let j = i; while (j < seg.length && /\d/.test(seg[j])) j++;
      const n = (j > i) ? parseInt(seg.slice(i, j), 10) : 1;
      const group = stack.pop(); stackTop--;
      const top = stack[stackTop];
      for (const el in group) top[el] = (top[el] || 0) + group[el] * n;
      i = j;
    }
    else if (/[A-Z]/.test(ch)) {
      let sym = ch;
      if (i + 1 < seg.length && /[a-z]/.test(seg[i + 1])) { sym += seg[i + 1]; }
      if (!(sym in MASS)) throw 'Símbolo de elemento não reconhecido: ' + sym;
      i += sym.length;
      let j = i; while (j < seg.length && /\d/.test(seg[j])) j++;
      const n = (j > i) ? parseInt(seg.slice(i, j), 10) : 1;
      const top = stack[stackTop];
      top[sym] = (top[sym] || 0) + n;
      i = j;
    }
    else if (/[a-z]/.test(ch)) { throw 'Letra minúscula (' + ch + ') onde começa um símbolo de elemento; verifique maiúsculas e minúsculas'; }
    else { throw 'Carácter não reconhecido: ' + ch; }
  }
  if (stackTop !== 0) throw 'Parênteses sem par';
  if (mult > 1) for (const el in counts) counts[el] *= mult;
  if (Object.keys(counts).length === 0) throw 'Há um fragmento vazio';
  return counts;
}

function parseFormula(input) {
  const segs = input.split(/[·.\*]/);
  const total = {};
  for (const seg of segs) {
    if (!seg.trim()) throw 'Há um fragmento vazio (verifique os separadores)';
    const c = parseSegment(seg);
    for (const el in c) total[el] = (total[el] || 0) + c[el];
  }
  return total;
}

function fmt(x) {
  return Math.abs(x - Math.round(x)) < 1e-9 ? String(Math.round(x)) : String(Math.round(x * 10000) / 10000);
}

// 质量 ⇌ 摩尔换算
function convertMassMol() {
  const mw = parseFloat(document.getElementById('mwVal').textContent);
  if (!mw) return;
  const mIn = document.getElementById('massIn'), nIn = document.getElementById('molIn');
  const m = parseFloat(mIn.value), n = parseFloat(nIn.value);
  const out = document.getElementById('convOut');
  const editingMass = document.activeElement === mIn;
  const editingMol = document.activeElement === nIn;
  if (editingMass && isFinite(m) && m > 0) {
    nIn.value = (Math.round(m / mw * 1e6) / 1e6);
    out.textContent = nIn.value + ' mol ⇌ ' + m + ' g';
  } else if (editingMol && isFinite(n) && n > 0) {
    mIn.value = (Math.round(n * mw * 1e6) / 1e6);
    out.textContent = mIn.value + ' g ⇌ ' + n + ' mol';
  }
}
document.getElementById('massIn').addEventListener('input', convertMassMol);
document.getElementById('molIn').addEventListener('input', convertMassMol);
</script>

<script is:inline src="/js/smiles-drawer.min.js?v=2" defer></script>
<script is:inline>
(function () {
  'use strict';
  const L = { iupac: 'Nome IUPAC', hbd: 'Dadores de pontes H', hba: 'Aceptores de pontes H', rot: 'Ligações rotativas', chg: 'Carga formal', heavy: 'Átomos pesados', viaF: 'Estrutura: correspondência mais próxima do PubChem para esta fórmula', empty: 'Introduz uma fórmula, uma cadeia SMILES ou o nome do composto', invalid: 'SMILES inválido: ', pub: 'Não foi possível resolver o nome via PubChem (sem rede ou não encontrado). Verifica o nome ou cola diretamente uma cadeia SMILES.', via: 'Estrutura e fórmula resolvidas via PubChem', hill: 'Fórmula molecular (Hill):', modeF: 'Interpretado como fórmula química', modeS: 'Interpretado como SMILES: estrutura desenhada' };
  const TH = ['Elemento', 'Átomos', 'Peso atómico', 'Contribuição (g/mol)'];
  const $ = (id) => document.getElementById(id);
  const TC_MASS = {H:1.008,He:4.0026,Li:6.94,Be:9.0122,B:10.81,C:12.011,N:14.007,O:15.999,F:18.998,
Ne:20.180,Na:22.990,Mg:24.305,Al:26.982,Si:28.085,P:30.974,S:32.06,Cl:35.45,Ar:39.948,
K:39.098,Ca:40.078,Sc:44.956,Ti:47.867,V:50.942,Cr:51.996,Mn:54.938,Fe:55.845,Co:58.933,
Ni:58.693,Cu:63.546,Zn:65.38,Ga:69.723,Ge:72.630,As:74.922,Se:78.971,Br:79.904,Kr:83.798,
Rb:85.468,Sr:87.62,Y:88.906,Zr:91.224,Nb:92.906,Mo:95.95,Tc:98,Ru:101.07,Rh:102.91,
Pd:106.42,Ag:107.87,Cd:112.41,In:114.82,Sn:118.71,Sb:121.76,Te:127.60,I:126.90,Xe:131.29,
Cs:132.91,Ba:137.33,La:138.91,Ce:140.12,Pr:140.91,Nd:144.24,Pm:145,Sm:150.36,Eu:151.96,
Gd:157.25,Tb:158.93,Dy:162.50,Ho:164.93,Er:167.26,Tm:168.93,Yb:173.05,Lu:174.97,Hf:178.49,
Ta:180.95,W:183.84,Re:186.21,Os:190.23,Ir:192.22,Pt:195.08,Au:196.97,Hg:200.59,Tl:204.38,
Pb:207.2,Bi:208.98,Po:209,At:210,Rn:222,Fr:223,Ra:226,Ac:227,Th:232.04,Pa:231.04,U:238.03,
Np:237,Pu:244};   // 自包含原子量表（IUPAC 2013）
  const tfmt = (x) => String(Math.round(x * 100000) / 100000);
// SMILES → 元素计数（含隐式氢）。纯函数、无 DOM，可 node 测试，亦可注入页面。
function smilesCounts(input) {
  const s = String(input || '').trim();
  if (!s) throw 'Empty input';
  const MASS_OK = /^[A-Z][a-z]?$/;
  const ARO = { b:'B', c:'C', n:'N', o:'O', p:'P', s:'S' };
  const ORG1 = { B:1, C:1, N:1, O:1, P:1, S:1, F:1, I:1 };
  const ORG2 = { Cl:1, Br:1 };
  const VALENCE = { B:[3], C:[4], N:[3], O:[2], P:[3,5], S:[2,4,6], F:[1], Cl:[1], Br:[1], I:[1] };
  const A = [];            // {el, bs(键级和), h(括号原子显式H), aro}
  const rings = {};        // 开环表
  let prev = -1, pend = null;
  const stack = [];
  const bondAdd = (a, b, o) => { A[a].bs += o; A[b].bs += o; };
  const newAtom = (el, aro, h) => {
    const a = { el, bs: 0, h: (h === undefined ? null : h), aro: !!aro };
    A.push(a);
    const cur = A.length - 1;
    if (prev >= 0) bondAdd(prev, cur, (pend != null) ? pend : ((a.aro && A[prev].aro) ? 1.5 : 1));
    pend = null; prev = cur;
    return cur;
  };
  let i = 0;
  while (i < s.length) {
    const ch = s[i];
    if (ch === '(') { stack.push(prev); i++; continue; }
    if (ch === ')') { if (!stack.length) throw 'Unbalanced parentheses'; prev = stack.pop(); i++; continue; }
    if (ch === '.') { prev = -1; pend = null; i++; continue; }
    if (ch === '-' || ch === '/' || ch === '\\') { pend = 1; i++; continue; }
    if (ch === '=') { pend = 2; i++; continue; }
    if (ch === '#') { pend = 3; i++; continue; }
    if (ch === ':') { pend = 1.5; i++; continue; }
    if (ch === '%') {
      const m = s.slice(i + 1).match(/^(\d{2})/);
      if (!m) throw 'Bad ring closure (%nn)';
      const r = m[1];
      if (rings[r] !== undefined) { const o = rings[r]; delete rings[r]; bondAdd(o.atom, prev, (pend != null) ? pend : ((o.aro && A[prev].aro) ? 1.5 : 1)); }
      else { rings[r] = { atom: prev, aro: A[prev].aro, order: pend }; if (pend != null) pend = null; }
      pend = null; i += 1 + m[1].length; continue;
    }
    if (/\d/.test(ch)) {
      const r = ch;
      if (rings[r] !== undefined) { const o = rings[r]; delete rings[r]; bondAdd(o.atom, prev, (pend != null) ? pend : ((o.aro && A[prev].aro) ? 1.5 : ((o.order != null) ? o.order : 1))); }
      else { rings[r] = { atom: prev, aro: A[prev].aro, order: pend }; if (pend != null) pend = null; }
      pend = null; i++; continue;
    }
    if (ch === '[') {
      const j = s.indexOf(']', i);
      if (j < 0) throw 'Unclosed bracket atom';
      const body = s.slice(i + 1, j);
      let k = 0;
      while (k < body.length && /\d/.test(body[k])) k++;                     // 同位素（忽略，按天然丰度计）
      if (k >= body.length) throw 'Empty bracket atom';
      let sym = body[k]; k++;
      if (k < body.length && /[a-z]/.test(body[k])) { sym += body[k]; k++; } // 两字母符号
      let aro = false;
      if (sym[0] >= 'a' && sym[0] <= 'z') { aro = true; sym = (ARO[sym] !== undefined) ? ARO[sym] : sym[0].toUpperCase() + sym.slice(1); }
      if (!MASS_OK.test(sym)) throw 'Unknown element in brackets: ' + sym;
      if (body[k] === '@') { k++; if (body[k] === '@') k++; else { const m2 = body.slice(k).match(/^(TH|AL|SP|TB|OH)\d+/); if (m2) k += m2[1].length + 1; } }
      let h = 0;
      if (body[k] === 'H') { k++; let d = ''; while (k < body.length && /\d/.test(body[k])) { d += body[k]; k++; } h = d ? parseInt(d, 10) : 1; }
      let charge = 0;
      if (body[k] === '+' || body[k] === '-') {
        const sign = body[k] === '+' ? 1 : -1; k++;
        let d = ''; while (k < body.length && body[k] === body[k - 1] && (body[k] === '+' || body[k] === '-')) { d += body[k]; k++; }
        let n = ''; while (k < body.length && /\d/.test(body[k])) { n += body[k]; k++; }
        charge = n ? sign * parseInt(n, 10) : sign * (1 + d.length);
      }
      if (body[k] === ':') { k++; while (k < body.length && /\d/.test(body[k])) k++; }
      if (k !== body.length) throw 'Cannot parse bracket atom [' + body + ']';
      if (charge !== 0 && !aro) { /* 带电括号原子：H 已显式给出 */ }
      newAtom(sym, aro, h);
      i = j + 1; continue;
    }
    if (ORG2[ch] !== undefined && /[a-z]/.test(s[i + 1] || '')) { newAtom(ch, false, null); i += 2; continue; }
    if (ORG1[ch]) { newAtom(ch, false, null); i++; continue; }
    if (ARO[ch]) { newAtom(ARO[ch], true, null); i++; continue; }
    throw 'Unrecognized character: ' + ch;
  }
  if (stack.length) throw 'Unbalanced parentheses';
  if (!A.length) throw 'No atoms found';
  for (const r in rings) throw 'Unclosed ring bond: ' + r;
  // 隐式氢：非括号原子 = 最小可容纳价态 − 键级和；括号原子 = 显式 H
  const counts = {};
  for (const a of A) {
    let H;
    if (a.h !== null) H = a.h;
    else {
      const vl = VALENCE[a.el] || [];
      let v = null;
      for (const x of vl) if (x >= a.bs - 1e-9) { v = x; break; }
      H = (v === null) ? 0 : Math.round(v - a.bs);
    }
    if (H < 0) H = 0;
    counts[a.el] = (counts[a.el] || 0) + 1;
    if (H > 0) counts.H = (counts.H || 0) + H;
  }
  return counts;
}
// 显示式：有碳按 Hill（C,H,余字母序）；无碳 H 最前（符合 NH3/H2SO4/SO2 惯例）
function hillFormula(c) {
  const parts = [];
  const push = (el, n) => parts.push(el + (n > 1 ? n : ''));
  const rest = Object.keys(c).filter((el) => el !== 'C' && el !== 'H').sort();
  if (c.C) { push('C', c.C); if (c.H) push('H', c.H); rest.forEach((el) => push(el, c[el])); }
  else { if (c.H) push('H', c.H); rest.forEach((el) => push(el, c[el])); }
  return parts.join('') || '—';
}
  function chainLike(s) { return !/[\d\[\]]/.test(s) && (s.includes('(') || /(.)\1/.test(s)); }   // CCO/NC(CO)… 类链式串 → SMILES 优先
  function renderCounts(counts) {
    let mw = 0; const rows = [];
    for (const el in counts) { const sub = TC_MASS[el] * counts[el]; mw += sub; rows.push([el, counts[el], TC_MASS[el], sub]); }
    rows.sort((a, b) => b[3] - a[3]);
    $('mwVal').textContent = tfmt(Math.round(mw * 100000) / 100000);
    let html = '<table class="tbl"><tr><th>' + TH[0] + '</th><th>' + TH[1] + '</th><th>' + TH[2] + '</th><th>' + TH[3] + '</th></tr>';
    for (const r of rows) html += '<tr><td>' + r[0] + '</td><td>' + r[1] + '</td><td>' + r[2] + '</td><td>' + tfmt(r[3]) + '</td></tr>';
    html += '</table>';
    $('compTable').innerHTML = html;
    $('fLine').innerHTML = L.hill + ' <span class="ktx">\\ce{' + hillFormula(counts) + '}</span>';
  }
  function showResult(withStruct, badge, via) {
    $('resultPanel').style.display = '';
    $('structWrap').style.display = withStruct ? '' : 'none';
    $('dlWrap').style.display = withStruct ? '' : 'none';
    if (!withStruct) $('structSvg').innerHTML = '';
    $('modeBadge').textContent = badge || '';
    const mi = $('molInfo'); if (mi) { mi.style.display = 'none'; mi.innerHTML = ''; }
    if (via) { $('sVia').textContent = via; $('sVia').style.display = ''; } else { $('sVia').style.display = 'none'; }
    $('convPanel').style.display = '';
    document.getElementById('massIn').dispatchEvent(new Event('input'));
    if (window.renderKtx) window.renderKtx($('resultPanel'));
  }
  function draw(smiles) {
    const d = new SmilesDrawer.SmiDrawer({ width: 520, height: 380, padding: 14, bondThickness: 1.1, terminalCarbons: false, noCondense: true });
    const host = $('structSvg');
    host.innerHTML = '';
    let frags = smiles.split('.');
    if (frags.length > 1) frags = frags.filter((f) => f !== 'O').concat(frags.filter((f) => f === 'O'));   // 水排最后（教科书序）
    const uniq = [];
    frags.forEach((f) => { const hit = uniq.find((u) => u.f === f); if (hit) hit.n++; else uniq.push({ f, n: 1 }); });
    uniq.forEach((u, idx) => {
      if (idx > 0) { const plus = document.createElement('span'); plus.className = 'frag-plus'; plus.textContent = '+'; host.appendChild(plus); }
      const cell = document.createElement('span'); cell.className = 'frag'; host.appendChild(cell);
      if (u.n > 1) { const mul = document.createElement('span'); mul.className = 'frag-mul'; mul.textContent = '×' + u.n; host.appendChild(mul); }
      const f = u.f === 'O' ? '[H]O[H]' : u.f;   // 裸 O（水）→ 显式 H-O-H
      try {
        d.draw(f, 'svg', 'light', function (svg) { if (svg) cell.appendChild(svg); }, function () { cell.textContent = '·'; });
      } catch (e) { cell.textContent = '·'; }
    });
  }
  async function pubchemData(kind, value) {   // kind: name|fastformula|cid|inchikey|inchi → SMILES + 性质一次取回
    const url = 'https://pubchem.ncbi.nlm.nih.gov/rest/pug/compound/' + kind + '/' + encodeURIComponent(value) +
      '/property/IsomericSMILES,SMILES,IUPACName,InChIKey,XLogP,HBondDonorCount,HBondAcceptorCount,TPSA,RotatableBondCount,Charge,HeavyAtomCount/JSON';
    const ctl = new AbortController(); const to = setTimeout(() => ctl.abort(), 9000);
    try {
      const r = await fetch(url, { signal: ctl.signal });
      if (!r.ok) return null;
      const j = await r.json();
      const p = j.PropertyTable && j.PropertyTable.Properties && j.PropertyTable.Properties[0];
      if (!p) return null;
      return { smiles: p.IsomericSMILES || p.SMILES || null, props: p };
    } catch (e) { return null; } finally { clearTimeout(to); }
  }
  function setMolInfo(pc) {
    const el = $('molInfo');
    if (!pc || !pc.props) { el.style.display = 'none'; el.innerHTML = ''; return; }
    const p = pc.props, rows = [];
    const add = (label, val) => { if (val !== undefined && val !== null && val !== '') rows.push('<div class="mi"><b>' + label + '</b>' + String(val) + '</div>'); };
    add(L.iupac, p.IUPACName); add('InChIKey', p.InChIKey); add('XLogP', p.XLogP);
    add(L.hbd, p.HBondDonorCount); add(L.hba, p.HBondAcceptorCount); add('TPSA (\u00c5\u00b2)', p.TPSA);
    add(L.rot, p.RotatableBondCount); add(L.chg, p.Charge); add(L.heavy, p.HeavyAtomCount);
    if (!rows.length) { el.style.display = 'none'; el.innerHTML = ''; return; }
    el.innerHTML = rows.join(''); el.style.display = '';
  }
  let curGen = 0;
  function setVia(t) { $('sVia').textContent = t; $('sVia').style.display = ''; }
  async function go() {
    const raw = $('q').value.trim();
    const myGen = ++curGen;
    $('err').textContent = '';
    $('resultPanel').style.display = 'none';
    if (!raw) { $('err').textContent = L.empty; return; }
    let fCounts = null;                 // ① 化学式（严格语法）
    try { fCounts = parseFormula(raw); } catch (e) {}
    const preferSmiles = fCounts && (fCounts.H === undefined) && chainLike(raw);   // CCO/NC(CO)… 链式串 → SMILES 优先
    if (fCounts && !preferSmiles) {
      renderCounts(fCounts); showResult(false, L.modeF, null);
      const pc = await pubchemData('fastformula', hillFormula(fCounts));
      if (myGen !== curGen) return;
      const smi = pc && pc.smiles;   // 普通分子式 → PubChem 最近匹配结构（渐进式）
      if (myGen !== curGen) return;
      if (smi) { try { smilesCounts(smi); draw(smi); $('structWrap').style.display = ''; $('dlWrap').style.display = ''; setVia(L.viaF); setMolInfo(pc); } catch (e) {} }
      return;
    }
    try {                               // ② SMILES
      const sc = smilesCounts(raw);
      renderCounts(sc); draw(raw); showResult(true, L.modeS, null); return;
    } catch (e2) {}
    if (fCounts) { renderCounts(fCounts); showResult(false, L.modeF, null); return; }   // 链式但 SMILES 失败 → 回落公式
    if (/^\d{1,12}$/.test(raw)) {        // ③ CID
      const pc = await pubchemData('cid', raw);
      if (myGen !== curGen) return;
      if (pc && pc.smiles) {
        try { const sc = smilesCounts(pc.smiles); renderCounts(sc); draw(pc.smiles); showResult(true, L.modeS, L.via); setMolInfo(pc); return; } catch (e) {}
      }
      $('err').textContent = L.pub; return;
    }
    if (/^InChI=/.test(raw) || /^[A-Z]{14}-[A-Z]{10}-[A-Z]$/.test(raw)) {   // ④ InChI / InChIKey
      const pc = await pubchemData(/^InChI=/.test(raw) ? 'inchi' : 'inchikey', raw);
      if (myGen !== curGen) return;
      if (pc && pc.smiles) {
        try { const sc = smilesCounts(pc.smiles); renderCounts(sc); draw(pc.smiles); showResult(true, L.modeS, L.via); setMolInfo(pc); return; } catch (e) {}
      }
      $('err').textContent = L.pub; return;
    }
    const pc = await pubchemData('name', raw);   // ⑤ 名称 → PubChem
    if (myGen !== curGen) return;
    const smi = pc && pc.smiles;
    if (myGen !== curGen) return;
    if (smi) {
      try {
        const sc = smilesCounts(smi);
        renderCounts(sc); draw(smi); showResult(true, L.modeS, L.via); setMolInfo(pc); return;
      } catch (e3) {}
    }
    $('err').textContent = L.pub;
  }
  $('calcBtn').addEventListener('click', go);
  $('q').addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); go(); } });
  document.querySelectorAll('.eg').forEach((a) => a.addEventListener('click', (e) => { e.preventDefault(); $('q').value = a.getAttribute('data-f'); go(); }));
  document.querySelectorAll('.eg-s').forEach((a) => a.addEventListener('click', (e) => { e.preventDefault(); $('q').value = a.getAttribute('data-s'); go(); }));
  function saveBlob(blob, name) {
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob); a.download = name;
    document.body.appendChild(a); a.click(); a.remove();
    setTimeout(() => URL.revokeObjectURL(a.href), 800);
  }
  function exportFmt(fmt) {
    const svg = document.querySelector('#structSvg svg');
    if (!svg) return;
    const clone = svg.cloneNode(true);
    clone.setAttribute('xmlns', 'http://www.w3.org/2000/svg');
    const data = new XMLSerializer().serializeToString(clone);
    const base = 'tubecalc-structure';
    if (fmt === 'svg') { saveBlob(new Blob([data], { type: 'image/svg+xml;charset=utf-8' }), base + '.svg'); return; }
    const url = URL.createObjectURL(new Blob([data], { type: 'image/svg+xml;charset=utf-8' }));
    const img = new Image();
    img.onload = function () {
      const w = img.naturalWidth || 520, h = img.naturalHeight || 380, scale = 3;
      const canvas = document.createElement('canvas');
      canvas.width = Math.round(w * scale); canvas.height = Math.round(h * scale);
      const ctx = canvas.getContext('2d');
      if (fmt === 'jpeg') { ctx.fillStyle = '#ffffff'; ctx.fillRect(0, 0, canvas.width, canvas.height); }
      ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
      URL.revokeObjectURL(url);
      canvas.toBlob(function (b) { if (b) saveBlob(b, base + '.' + (fmt === 'jpeg' ? 'jpg' : fmt)); }, 'image/' + fmt, 0.95);
    };
    img.onerror = function () { URL.revokeObjectURL(url); };
    img.src = url;
  }
  $('dlBtn').addEventListener('click', function (e) { e.stopPropagation(); $('dlMenu').classList.toggle('open'); });
  document.querySelectorAll('#dlMenu .dl-item').forEach(function (b) {
    b.addEventListener('click', function (e) { e.stopPropagation(); $('dlMenu').classList.remove('open'); exportFmt(b.getAttribute('data-fmt')); });
  });
  document.addEventListener('click', function () { $('dlMenu').classList.remove('open'); });
})();
</script>